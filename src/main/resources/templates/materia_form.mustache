<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Nueva Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Nueva Materia</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <span>{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <span>{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/materias/new" method="post" class="space-y-4">
            <div>
                <label for="codigo_mat" class="block text-gray-700 text-sm font-medium mb-1">Código de Materia:</label>
                <input type="number" id="codigo_mat" name="codigo_mat" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="nombre_mat" class="block text-gray-700 text-sm font-medium mb-1">Nombre de la Materia:</label>
                <input type="text" id="nombre_mat" name="nombre_mat" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700">
                Guardar Materia
            </button>
            <div class="text-center mt-4">
                <a href="/dashboard" class="text-blue-600 hover:underline text-sm">Volver al Panel</a>
            </div>
        </form>
    </div>
</body>
</html>