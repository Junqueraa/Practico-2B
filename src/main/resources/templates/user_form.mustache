<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Crear una cuenta</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-lg">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">
            {{#adminForm}}Crear usuario{{/adminForm}}{{^adminForm}}Crear una cuenta{{/adminForm}}
        </h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/user/new" method="post" class="space-y-4">
            <div>
                <label for="name" class="block text-gray-700 text-sm font-medium mb-1">Nombre de Usuario:</label>
                <input type="text" id="name" name="name" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="password" class="block text-gray-700 text-sm font-medium mb-1">Contraseña:</label>
                <input type="password" id="password" name="password" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            {{#adminForm}}
            <div>
                <label for="role" class="block text-gray-700 text-sm font-medium mb-1">Rol:</label>
                <select id="role" name="role" onchange="toggleRoleFields(this.value)"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="admin">Administrador</option>
                    <option value="alumno">Alumno</option>
                    <option value="profesor">Profesor</option>
                </select>
            </div>

            <div id="campo-alumno" class="hidden">
                <label for="alumno_id" class="block text-gray-700 text-sm font-medium mb-1">Vincular con Alumno:</label>
                <select id="alumno_id" name="alumno_id"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Seleccionar alumno --</option>
                    {{#alumnos}}
                    <option value="{{id}}">{{nombre_y_apellido}} (DNI: {{dni}})</option>
                    {{/alumnos}}
                </select>
            </div>

            <div id="campo-profesor" class="hidden">
                <label for="profesor_id" class="block text-gray-700 text-sm font-medium mb-1">Vincular con Profesor:</label>
                <select id="profesor_id" name="profesor_id"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Seleccionar profesor --</option>
                    {{#profesores}}
                    <option value="{{id}}">{{nombre_y_apellido}} (DNI: {{dni}})</option>
                    {{/profesores}}
                </select>
            </div>
            {{/adminForm}}

            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Registrar Usuario
            </button>
            <div class="text-center mt-4">
                <a href="/" class="text-blue-600 hover:underline text-sm">Volver al inicio</a>
            </div>
        </form>
    </div>

    <script>
        function toggleRoleFields(role) {
            document.getElementById('campo-alumno').classList.add('hidden');
            document.getElementById('campo-profesor').classList.add('hidden');
            if (role === 'alumno') {
                document.getElementById('campo-alumno').classList.remove('hidden');
            } else if (role === 'profesor') {
                document.getElementById('campo-profesor').classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
